# 由 deploy.sh 自动生成的宿主机运行配置；日常参数优先修改 deploy.sh 顶部配置区。
# deploy.sh 会保留数据库密码、主密钥、邀请码及 Agent 令牌，更新源码不会更换它们。
# 真实 .env 不提交 Git；备份和服务器迁移时须妥善保存。无需手动复制空密钥模板。

# 公网 IP 只用来提示 DNS 指向，不用于绑定监听端口。
MARIO_SERVER_IP=
# 域名不含协议、端口或路径；网页前缀以 / 开头和结尾。
MARIO_DOMAIN=localhost
MARIO_BASE_PATH=/

# 下面四个值首次自动生成，不要随意修改；丢失主密钥将无法解密已有模型凭据。
POSTGRES_PASSWORD=
MARIO_MASTER_KEY=
# 邀请码分发给需要注册的用户；轮换不影响已有账号。
MARIO_REGISTRATION_KEY=
# API 与独立 Agent 的内部认证令牌，不用于用户登录。
MARIO_AGENT_TOKEN=

# 模型 HTTPS 主机白名单，逗号分隔；用户的 API Key 在网页里配置。
MARIO_MODEL_HOSTS=api.openai.com,api.anthropic.com
# 同源网页不需填写；跨域客户端填写完整 Origin，逗号分隔。
MARIO_ALLOWED_ORIGINS=

# 为空则管理 .runtime/native/postgres；已有数据库 URL 请在 deploy.sh 中填写。
DATABASE_URL=
# PostgreSQL bin 目录，脚本自动发现；含 initdb/pg_ctl/pg_dump/pg_restore/psql。
PG_BIN=
# 都只监听 127.0.0.1，三个端口不得相同。
MARIO_PORT=4217
MARIO_AGENT_PORT=4218
MARIO_PG_PORT=55432

# 数据迁移设置：宿主机使用 native；旧 auto 值仍接受并按 native 处理。
MARIO_BACKUP_MODE=native
# 备份目录不要放在公开网页目录；相对项目根目录。
MARIO_BACKUP_DIR=backups
# 下面四项是本机 SSH 一键下载工具的可选默认值，可用命令参数代替。
MARIO_BACKUP_SSH_HOST=
MARIO_BACKUP_REMOTE_DIR=
MARIO_BACKUP_SSH_PORT=22
MARIO_BACKUP_SSH_IDENTITY=
# 独立备份密码运行时输入或通过 MARIO_BACKUP_PASSWORD 设置，不写到这里。
