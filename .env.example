# Mario 统一部署配置：Docker 和无 Docker 启动脚本都读取项目根目录 .env。
# 首次生成完整配置和随机密钥：node scripts/generate-env.mjs
# 本文件是模板；生成的 .env 保留这些注释。不要把真实 .env 提交到 Git。
# 格式：KEY=value；注释放在独立行。路径推荐使用 /，带空格的值可用引号包围。
# 修改后重启服务生效；切换启动方式不会自动迁移两套数据库中的数据。

# ---------- 访问地址（通常只需修改这一项） ----------
# [两种方式] 域名，不带 https://、端口或路径。例如 mario.example.com。
# localhost 用于本机测试；公网部署需解析域名并开放 80/443。
MARIO_DOMAIN=localhost

# ---------- 数据库与凭据（生成脚本自动填写，不要随意更换） ----------
# [两种方式] 内置 PostgreSQL 密码，至少 32 位十六进制。
# 修改配置不会修改已初始化数据库的密码，需先在数据库中完成密码变更。
POSTGRES_PASSWORD=
# [两种方式] 加密用户模型 API Key 的主密钥：32 字节随机值的 Base64。
# 必须单独备份；丢失或替换后无法解密原有凭据。
MARIO_MASTER_KEY=
# [两种方式] 注册邀请码，至少 32 字符。分发给需要注册的用户。
MARIO_REGISTRATION_KEY=
# [两种方式] 后端与独立 Agent 的内部认证令牌，至少 32 字符。
MARIO_AGENT_TOKEN=

# ---------- 模型访问与网页来源（一般保留默认） ----------
# [两种方式] 允许模型请求访问的 HTTPS 主机，逗号分隔，不含协议和路径。
# 用户自己的模型名称、API Key 在登录后的“模型与隐私”中配置，不放在本文件。
MARIO_MODEL_HOSTS=api.openai.com,api.anthropic.com
# [两种方式] 额外允许访问 API 的网页 Origin，逗号分隔。
# 同源网页与默认 Tauri 客户端无需填写。例：https://another.example.com
MARIO_ALLOWED_ORIGINS=

# ---------- 以下仅用于无 Docker 启动，Docker 忽略这些项 ----------
# 是否同时启动 Caddy 提供 HTTPS：true / false。
# true 时需安装 Caddy、配置上述域名并具备绑定 80/443 的权限。
# false 时 API 仅在 http://127.0.0.1:MARIO_PORT 提供服务，可复用已有反向代理。
MARIO_NATIVE_HTTPS=false
# 已有 PostgreSQL 的连接地址；留空则自动管理 .runtime/native/postgres。
# 例：postgresql://mario:URL编码后的密码@127.0.0.1:5432/mario
# Docker 始终使用 compose.yaml 的 database 容器，不使用此连接地址。
DATABASE_URL=
# PostgreSQL bin 目录；留空表示从 PATH 查找 initdb 和 pg_ctl。
# Linux 示例：/usr/lib/postgresql/17/bin；Windows 示例：C:/Program Files/PostgreSQL/17/bin
# 配置 DATABASE_URL 时无需本地 PostgreSQL 工具。
PG_BIN=
# API / Agent / 本地 PostgreSQL 端口，三者不可重复；都只监听 127.0.0.1。
MARIO_PORT=4217
MARIO_AGENT_PORT=4218
MARIO_PG_PORT=55432

# ---------- 备份、下载与频繁搬迁 ----------
# auto 自动选择：配置外部数据库或存在原生数据目录时为 native，否则为 docker。
# 同一目录使用过两种部署方式时，请明确填写 native 或 docker，防止备份错误数据库。
MARIO_BACKUP_MODE=auto
# 备份/下载文件存放目录，相对项目根目录；包含所有用户的数据，目录不要放在网页目录中。
MARIO_BACKUP_DIR=backups
# 下面四项仅供“在本机一键从服务器打包下载”的脚本使用，手动传参数时可留空。
# 支持 user@服务器地址 或 ~/.ssh/config 中的别名。
MARIO_BACKUP_SSH_HOST=
# 远端服务器上的项目目录，例 /srv/mario；SSH 下载脚本适用于 Linux/macOS 源服务器。
MARIO_BACKUP_REMOTE_DIR=
MARIO_BACKUP_SSH_PORT=22
# 可选 SSH 私钥文件路径；留空使用系统 SSH agent/默认密钥。
MARIO_BACKUP_SSH_IDENTITY=
# 迁移包使用独立密码加密，运行时输入，或设置 MARIO_BACKUP_PASSWORD 环境变量。
# 不要将备份密码写在本配置文件中；遗失密码无法解密迁移包。

# ---------- 由启动器自动设置，无需在这里填写 ----------
# MARIO_HOST、MARIO_WEB_DIR、MARIO_ROLE、MARIO_AGENT_URL、MARIO_AGENT_BIND。
# Docker 的内部端口及公网 80/443 在 compose.yaml 中固定配置。
# 无 Docker 数据目录 .runtime/native；Docker 使用 postgres-data 持久卷。
