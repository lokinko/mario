{
  "name": "mario-workspace",
  "private": true,
  "version": "0.6.0",
  "scripts": {
    "check:architecture": "node scripts/check-architecture.mjs && node --test scripts/check-architecture.test.mjs",
    "test:startup": "node scripts/test-startup.mjs",
    "test:postgres-start": "node scripts/test-postgres-start.mjs",
    "data:backup": "node scripts/backup.mjs",
    "data:download": "node scripts/download-backup.mjs",
    "data:restore": "node scripts/restore-backup.mjs",
    "test:backup": "node scripts/test-backup.mjs",
    "test:deployment": "node scripts/test-deployment.mjs",
    "install:all": "npm install --ignore-scripts && npm install --prefix client --ignore-scripts",
    "dev": "concurrently -k -n server,client -c green,blue \"cargo run --manifest-path server/Cargo.toml -- --allow-unauthenticated-dev\" \"npm run dev --prefix client\"",
    "test": "bash scripts/test.sh",
    "web:build": "node scripts/build-web.mjs",
    "server:check": "cargo check --manifest-path server/Cargo.toml",
    "test:hosted": "node scripts/test-hosted.mjs",
    "deploy": "bash deploy.sh",
    "test:deploy": "node scripts/test-deploy.mjs"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
