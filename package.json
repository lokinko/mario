{
  "name": "mario-workspace",
  "private": true,
  "version": "0.6.0",
  "scripts": {
    "codex:bridge": "node scripts/codex-bridge.mjs",
    "test:codex-bridge": "node scripts/postgres-cluster.mjs node scripts/test-codex-bridge.mjs",
    "check:architecture": "node scripts/check-architecture.mjs && node --test scripts/check-architecture.test.mjs",
    "test:startup": "node scripts/test-startup.mjs",
    "test:postgres-start": "node scripts/test-postgres-start.mjs",
    "data:backup": "node scripts/backup.mjs",
    "data:download": "node scripts/download-backup.mjs",
    "data:restore": "node scripts/restore-backup.mjs",
    "test:backup": "node scripts/test-backup.mjs",
    "test:deployment": "node scripts/test-deployment.mjs",
    "install:all": "npm install --ignore-scripts && npm install --prefix client --ignore-scripts",
    "dev": "node scripts/dev.mjs",
    "test": "bash scripts/test.sh",
    "test:server": "node scripts/postgres-cluster.mjs cargo test --manifest-path server/Cargo.toml",
    "eval:qa": "node scripts/postgres-cluster.mjs cargo test --manifest-path server/Cargo.toml live_evidence_advice_evaluation -- --ignored --nocapture",
    "eval:qa:score": "node scripts/qa-eval-score.mjs",
    "test:qa-eval": "node --test scripts/qa-eval-score.test.mjs",
    "web:build": "node scripts/build-web.mjs",
    "server:check": "cargo check --manifest-path server/Cargo.toml",
    "test:hosted": "node scripts/postgres-cluster.mjs node scripts/test-hosted.mjs",
    "test:financial": "node scripts/test-financial.mjs",
    "deploy": "bash deploy.sh",
    "test:deploy": "node scripts/test-deploy.mjs"
  }
}
