{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Default desktop capability",
  "platforms": ["macOS", "windows", "linux"],
  "windows": ["main"],
  "permissions": [
    "core:default",
    "notification:default",
    {
      "identifier": "shell:allow-spawn",
      "allow": [{ "name": "mario-server", "sidecar": true, "args": true }]
    }
  ]
}
